.dot {
  position: absolute;
  border-radius: 50%;
}
.dot-pink { width: 28rpx; height: 28rpx; background: #ff64c8; top: 52rpx; left: 68rpx; }
.dot-yellow { width: 18rpx; height: 18rpx; background: #f5d75e; top: 88rpx; left: 168rpx; }
.dot-teal { width: 24rpx; height: 24rpx; background: #2a9d99; top: 64rpx; right: 132rpx; }
.dot-orange { width: 16rpx; height: 16rpx; background: #dd5b00; top: 112rpx; right: 68rpx; }
.logo {
  width: 104rpx;
  height: 104rpx;
  border-radius: 24rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 40rpx;
}
.btn-row {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 52rpx;
}
.agree {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
}
.check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  flex-shrink: 0;
}
.check.checked {
  background: var(--primary);
}
.agree-txt {
  font-size: 26rpx;
  color: var(--slate);
}
.link {
  color: var(--link-blue);
}
.fine {
  text-align: center;
  font-size: 22rpx;
  color: var(--stone);
}
