<view class="page">
  <view wx:if="{{loadError}}" class="error-banner" bindtap="retry">
    <text>数据加载失败，云端暂时不可用</text>
    <text class="error-retry">点此重试</text>
  </view>
  <view class="navy-hero">
    <view class="hero-user" bindtap="editProfile">
      <image wx:if="{{avatar}}" class="hero-avatar" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="hero-avatar hero-avatar-text">{{nickname[0]}}</view>
      <view class="hero-id">
        <text class="hero-title">{{nickname}}</text>
        <text class="hero-edit">点击修改昵称 / 头像</text>
      </view>
    </view>
    <view class="hero-sub">你好，今天也要坚持</view>
    <view class="hero-week">
      <view class="hw">
        <text class="hw-b">{{week.count}}</text>
        <text class="hw-s">本周训练（次）</text>
      </view>
      <view class="hw">
        <text class="hw-b">{{weekText.calories}}</text>
        <text class="hw-s">本周消耗（kcal）</text>
      </view>
    </view>
    <view class="hero-strip">
      <view class="hs-item"><text class="hs-b">{{streak}}</text><text class="hs-s">连续训练（天）</text></view>
      <view class="hs-div"></view>
      <view class="hs-item"><text class="hs-b">{{totalWorkouts}}</text><text class="hs-s">累计训练（次）</text></view>
    </view>
  </view>

  <view class="pane">
    <view class="btn btn-primary btn-block" bindtap="start">开始训练</view>

    <block wx:if="{{suggestion && suggestion.items.length}}">
      <view class="suggest-card card">
        <view class="suggest-head">
          <text class="suggest-label">今天练什么？</text>
          <text class="suggest-focus">{{suggestion.focus}}</text>
        </view>
        <view class="suggest-item" wx:for="{{suggestion.items}}" wx:key="name">
          <text class="si-name">{{item.name}}</text>
          <text class="si-advice">上次 {{item.last}} · 建议{{item.increased ? '加重' : ''}} {{item.weight}}kg × {{item.targetReps}}</text>
        </view>
        <view class="suggest-tip">根据上次表现自动建议，先保持重量、练够次数再加</view>
      </view>
    </block>

    <navigator wx:if="{{needProfile}}" class="card profile-cta" url="/pages/onboarding/onboarding" hover-class="lib-entry-hover">
      完善资料（可选）· 记录年龄/身高/体重，获得更准的重量与热量建议 ›
    </navigator>

    <navigator class="card lib-entry" url="/pages/library/library" hover-class="lib-entry-hover">
      <view class="lib-entry-t">健身动作库</view>
      <view class="lib-entry-s">190+ 动作图解与演示 · 免登录浏览</view>
      <view class="lib-entry-a">›</view>
    </navigator>

    <view class="section">最近一次训练</view>
    <view wx:if="{{recent}}" class="card recent">
      <view class="recent-head">
        <text class="recent-date">{{recent.dateLabel}}</text>
        <text class="tag">{{recent.mode === 'template' ? '模板训练' : '自由训练'}}</text>
      </view>
      <view class="recent-vol">{{recent.displayText}}</view>
      <view class="recent-meta">{{recent.date}} · {{recent.exerciseCount}} 个动作 · {{recent.totalSets}} 组</view>
    </view>
    <view wx:else class="empty">
      <view class="empty-title">还没有训练记录</view>
      <view>点击上方「开始训练」记录第一次</view>
    </view>

    <view class="section">我的成就</view>
    <view class="ach-grid">
      <view wx:for="{{achievements}}" wx:key="id" class="ach {{item.done ? 'ach-on' : 'ach-off'}}">
        <text class="ach-name">{{item.name}}</text>
        <text class="ach-state">{{item.done ? '已达成' : '未达成'}}</text>
      </view>
    </view>
  </view>
</view>
