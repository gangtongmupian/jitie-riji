<view class="page">
  <view class="navy-hero">
    <view class="hero-title">牛来举铁</view>
    <view class="hero-sub">你好，今天也要坚持</view>
    <view class="hero-week">
      <view class="hw">
        <text class="hw-b">{{week.count}}</text>
        <text class="hw-s">本周训练</text>
      </view>
      <view class="hw">
        <text class="hw-b">{{weekText.duration}}</text>
        <text class="hw-s">本周时长</text>
      </view>
      <view class="hw">
        <text class="hw-b">{{weekText.volume}}</text>
        <text class="hw-s">本周容量</text>
      </view>
    </view>
  </view>

  <view class="pane">
    <view class="btn btn-primary btn-block" bindtap="start">开始训练</view>

    <view class="section">最近一次训练</view>
    <view wx:if="{{recent}}" class="card recent">
      <view class="recent-head">
        <text class="recent-date">{{recent.dateLabel}}</text>
        <text class="tag">{{recent.mode === 'template' ? '模板训练' : '自由训练'}}</text>
      </view>
      <view class="recent-vol">{{recent.volumeText}}</view>
      <view class="recent-meta">{{recent.exerciseCount}} 个动作 · {{recent.totalSets}} 组</view>
    </view>
    <view wx:else class="empty">
      <view class="empty-title">还没有训练记录</view>
      <view>点击上方「开始训练」记录第一次</view>
    </view>
  </view>
</view>
