.hero-week {
  display: flex;
  margin-top: 48rpx;
}
.hw {
  flex: 1;
  text-align: center;
}
.hw + .hw {
  border-left: 1rpx solid var(--navy-mid);
}
.hw-b {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--on-dark);
}
.hw-s {
  display: block;
  font-size: 22rpx;
  color: var(--on-dark-muted);
  margin-top: 6rpx;
}

.recent {
  padding: 28rpx 32rpx;
}
.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recent-date {
  font-size: 26rpx;
  color: var(--steel);
}
.recent-vol {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  margin-top: 12rpx;
}
.recent-meta {
  font-size: 26rpx;
  color: var(--slate);
  margin-top: 4rpx;
}
