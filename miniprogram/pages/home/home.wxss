.hero-week {
  display: flex;
  margin-top: 48rpx;
}
.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 20rpx 24rpx 0;
  padding: 0 28rpx;
  min-height: 88rpx;
  background: var(--surface);
  border: 1rpx solid var(--warning);
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--warning-deep);
}
.error-retry {
  font-weight: 600;
  color: var(--warning-deep);
  margin-left: 24rpx;
}
.lib-entry {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  padding: 28rpx 32rpx;
  position: relative;
}
.lib-entry-hover {
  background: var(--surface);
}
.lib-entry-t {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}
.lib-entry-s {
  font-size: 24rpx;
  color: var(--slate);
  margin-top: 6rpx;
}
.lib-entry-a {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: var(--stone);
}
.hero-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.hero-user {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 96rpx;
}
.hero-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.hero-avatar-text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--on-dark);
}
.hero-id {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.hero-edit {
  font-size: 26rpx;
  color: var(--on-dark-muted);
}
.hw {
  flex: 1;
  text-align: center;
}
.hw + .hw {
  border-left: 1rpx solid var(--navy-mid);
}
.hw-b {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--on-dark);
  font-variant-numeric: tabular-nums;
}
.hw-s {
  display: block;
  font-size: 22rpx;
  color: var(--on-dark-muted);
  margin-top: 6rpx;
}
.hero-strip {
  display: flex;
  align-items: center;
  margin: 36rpx 0 8rpx;
  padding: 24rpx 32rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: var(--r-md);
}
.hs-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hs-div {
  width: 1rpx;
  height: 48rpx;
  background: var(--navy-mid);
}
.hs-b {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--on-dark);
  font-variant-numeric: tabular-nums;
}
.hs-s {
  font-size: 22rpx;
  color: var(--on-dark-muted);
  margin-top: 4rpx;
}
.ach-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.ach {
  width: calc((100% - 32rpx) / 3);
  box-sizing: border-box;
  padding: 20rpx 12rpx;
  border-radius: var(--r-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.ach-on {
  background: var(--tint-lavender);
  color: var(--primary-deep);
}
.ach-off {
  background: var(--surface);
  color: var(--stone);
  opacity: 0.7;
}
.ach-name {
  font-size: 24rpx;
  font-weight: 600;
}
.ach-state {
  font-size: 20rpx;
}

.recent {
  padding: 28rpx 32rpx;
}
.recent-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.recent-date {
  font-size: 26rpx;
  color: var(--steel);
}
.recent-vol {
  font-size: 52rpx;
  font-weight: 600;
  letter-spacing: -1rpx;
  margin-top: 12rpx;
  font-variant-numeric: tabular-nums;
}
.recent-meta {
  font-size: 26rpx;
  color: var(--slate);
  margin-top: 4rpx;
}
