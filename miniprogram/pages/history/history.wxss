.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--steel);
}
.error-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 28rpx;
  min-height: 88rpx;
  background: var(--surface);
  border: 1rpx solid var(--warning);
  border-radius: var(--r-md);
  font-size: 26rpx;
  color: var(--warning-deep);
}
.error-retry {
  font-weight: 600;
  color: var(--warning-deep);
  margin-left: 24rpx;
}

.period-grid {
  display: flex;
  gap: 16rpx;
}
.period-card {
  flex: 1;
  padding: 24rpx 16rpx;
  text-align: center;
}
.period-label {
  display: block;
  font-size: 24rpx;
  color: var(--steel);
}
.period-kcal {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--primary-deep);
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
}
.period-sub {
  display: block;
  font-size: 22rpx;
  color: var(--stone);
  margin-top: 6rpx;
}

.day-workout {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.day-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.day-time {
  font-size: 26rpx;
  color: var(--steel);
}
.day-stat {
  font-size: 28rpx;
  font-weight: 600;
  margin: 12rpx 0;
}
.day-ex {
  padding: 12rpx 0;
  border-top: 1rpx solid var(--hairline-soft);
}
.day-ex-name {
  font-size: 28rpx;
  font-weight: 600;
}
.day-ex-sets {
  margin-top: 6rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.day-set {
  font-size: 22rpx;
  color: var(--slate);
  background: var(--surface);
  border-radius: var(--r-sm);
  padding: 4rpx 14rpx;
}

.cal-card {
  padding: 20rpx 16rpx 24rpx;
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}
.cal-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  font-size: 40rpx;
  color: var(--steel);
}
.cal-title {
  font-size: 30rpx;
  font-weight: 600;
}
.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--steel);
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: 14.285%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--charcoal);
}
.cal-active {
  position: relative;
}
.cal-active text {
  color: #fff;
  background: var(--primary);
  border-radius: 50%;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.pr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--hairline-soft);
}
.pr-row:last-child {
  border-bottom: none;
}
.pr-name {
  display: flex;
  flex-direction: column;
}
.pr-title {
  font-size: 30rpx;
  font-weight: 600;
}
.pr-date {
  font-size: 22rpx;
  color: var(--stone);
  margin-top: 4rpx;
}
.pr-val {
  text-align: right;
}
.pr-b {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
.pr-s {
  display: block;
  font-size: 22rpx;
  color: var(--slate);
  margin-top: 4rpx;
}
.day-share {
  margin-top: 16rpx;
  width: 100%;
  text-align: center;
  padding: 14rpx 0;
}
