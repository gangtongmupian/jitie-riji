.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--steel);
}

.trend-card {
  padding: 24rpx 20rpx 16rpx;
}
.bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 220rpx;
}
.bar-col {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.bar-fill {
  width: 100%;
  min-height: 6rpx;
  background: var(--primary);
  border-radius: 6rpx 6rpx 0 0;
}
.bar-labels {
  display: flex;
  gap: 8rpx;
  margin-top: 8rpx;
}
.bar-label {
  flex: 1;
  text-align: center;
  font-size: 18rpx;
  color: var(--stone);
}

.cal-card {
  padding: 20rpx 16rpx 24rpx;
}
.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 16rpx;
}
.cal-nav {
  font-size: 40rpx;
  color: var(--steel);
  padding: 0 24rpx;
}
.cal-title {
  font-size: 30rpx;
  font-weight: 600;
}
.cal-week {
  display: flex;
  margin-bottom: 8rpx;
}
.cal-wd {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: var(--steel);
}
.cal-grid {
  display: flex;
  flex-wrap: wrap;
}
.cal-cell {
  width: 14.285%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: var(--charcoal);
}
.cal-active {
  position: relative;
}
.cal-active text {
  color: #fff;
  background: var(--primary);
  border-radius: 50%;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
}

.pr-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 32rpx;
  border-bottom: 1rpx solid var(--hairline-soft);
}
.pr-row:last-child {
  border-bottom: none;
}
.pr-name {
  display: flex;
  flex-direction: column;
}
.pr-title {
  font-size: 30rpx;
  font-weight: 600;
}
.pr-date {
  font-size: 22rpx;
  color: var(--stone);
  margin-top: 4rpx;
}
.pr-val {
  text-align: right;
}
.pr-b {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}
.pr-s {
  display: block;
  font-size: 22rpx;
  color: var(--slate);
  margin-top: 4rpx;
}
