<view class="page">
  <view class="pane">
    <view wx:if="{{loading}}" class="loading">加载中…</view>

    <block wx:else>
      <view class="section">近 8 周训练容量</view>
      <view class="card trend-card">
        <view class="bars">
          <view class="bar-col" wx:for="{{trend}}" wx:key="weekStart">
            <view class="bar-fill" style="height: {{item.h}}%"></view>
          </view>
        </view>
        <view class="bar-labels">
          <text class="bar-label" wx:for="{{trend}}" wx:key="weekStart">{{item.label}}</text>
        </view>
      </view>

      <view class="section">训练日历</view>
      <view class="card cal-card">
        <view class="cal-head">
          <text class="cal-nav" bindtap="prevMonth">‹</text>
          <text class="cal-title">{{monthLabel}}</text>
          <text class="cal-nav" bindtap="nextMonth">›</text>
        </view>
        <view class="cal-week">
          <text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this" class="cal-wd">{{item}}</text>
        </view>
        <view class="cal-grid">
          <view wx:for="{{calendar}}" wx:key="key" class="cal-cell {{item.active ? 'cal-active' : ''}}">
            <text>{{item.day}}</text>
          </view>
        </view>
      </view>

      <view class="section">个人最好成绩</view>
      <view wx:if="{{prsList.length}}" class="list">
        <view class="pr-row" wx:for="{{prsList}}" wx:key="name">
          <view class="pr-name">
            <text class="pr-title">{{item.name}}</text>
            <text class="pr-date">{{item.bestWeightDate}}</text>
          </view>
          <view class="pr-val">
            <text class="pr-b">{{item.bestWeight}}kg</text>
            <text class="pr-s">单组 {{item.bestVolume}}kg</text>
          </view>
        </view>
      </view>
      <view wx:else class="empty">
        <view class="empty-title">还没有 PR</view>
        <view>完成训练后会在这里生成你的最好成绩</view>
      </view>
    </block>
  </view>
</view>
