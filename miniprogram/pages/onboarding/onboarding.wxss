.loading {
  padding: 160rpx 0;
  text-align: center;
  color: var(--steel);
}

.next-btn {
  margin-top: 48rpx;
}

.back {
  display: block;
  text-align: center;
  margin-top: 32rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.field-grid {
  display: flex;
  gap: 20rpx;
}
.field {
  flex: 1;
  position: relative;
}
.field .input {
  width: 100%;
  padding-right: 64rpx;
}
.unit {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 26rpx;
  color: var(--steel);
}

.agree-card {
  padding: 24rpx;
}
.agree-scroll {
  height: 360rpx;
}
.agree-text {
  font-size: 26rpx;
  color: var(--slate);
  line-height: 1.6;
  white-space: pre-line;
}
.agree-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline-soft);
}
.check {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid var(--hairline-strong);
  border-radius: 8rpx;
  color: #fff;
  font-size: 28rpx;
  line-height: 38rpx;
  text-align: center;
  box-sizing: border-box;
}
.check-on {
  background: var(--primary);
  border-color: var(--primary);
}
.agree-label {
  font-size: 26rpx;
  color: var(--slate);
}
