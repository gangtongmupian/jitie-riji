<view class="page">
  <view wx:if="{{loading}}" class="loading">加载中…</view>

  <view wx:elif="{{step === 3}}" class="pane">
    <view class="mtitle">这是你的起点</view>
    <view class="msub">依据中国标准计算，后续可在「我的」中修改。</view>
    <view class="metric-grid">
      <view class="metric metric-tint-lavender">
        <text class="metric-b">{{result.bmi}}</text>
        <text class="metric-s">BMI · {{result.bmiLevelLabel}}</text>
      </view>
      <view class="metric metric-tint-mint">
        <text class="metric-b">{{result.bodyFatRef}}</text>
        <text class="metric-s">体脂参考</text>
      </view>
      <view class="metric metric-tint-sky">
        <text class="metric-b">{{result.bmr}}</text>
        <text class="metric-s">基础代谢 kcal</text>
      </view>
    </view>
    <view class="btn btn-primary btn-block next-btn" bindtap="finish">进入牛来举铁</view>
  </view>

  <view wx:else class="pane">
    <view class="step-row" wx:if="{{step > 0}}">
      <text class="step-lbl">第 {{step}} / 2 步</text>
      <view class="bar-track"><view class="bar-fill" style="width: {{step * 50}}%"></view></view>
    </view>

    <view wx:if="{{step === 0}}">
      <view class="mtitle">欢迎来到牛来举铁</view>
      <view class="msub">记录每次训练，看见进步，分享成果。</view>
      <view wx:if="{{invited}}" class="invite-hint">🎁 来自好友的邀请：完成建档即可解锁「进阶计划」</view>
      <view class="card agree-card">
        <scroll-view scroll-y class="agree-scroll">
          <text class="agree-text">{{agreement}}</text>
        </scroll-view>
        <view class="agree-row" bindtap="toggleAgree">
          <view class="check {{agree ? 'check-on' : ''}}">{{agree ? '✓' : ''}}</view>
          <text class="agree-label">我已阅读并同意上述内容</text>
        </view>
      </view>
      <view class="btn btn-primary btn-block next-btn" bindtap="next">同意并开始</view>
    </view>

    <view wx:elif="{{step === 1}}">
      <view class="mtitle">先认识一下你</view>
      <view class="msub">用于计算 BMI、体脂参考与推荐重量。</view>
      <view class="section">性别</view>
      <view class="pill-row">
        <view class="pill {{form.gender === 'male' ? 'pill-sel' : ''}}" data-field="gender" data-value="male" bindtap="pick">男</view>
        <view class="pill {{form.gender === 'female' ? 'pill-sel' : ''}}" data-field="gender" data-value="female" bindtap="pick">女</view>
      </view>
      <view class="section">年龄 / 身高 / 体重</view>
      <view class="field-grid">
        <view class="field">
          <input class="input" type="number" data-field="age" value="{{form.age}}" bindinput="onInput" placeholder="年龄" />
          <text class="unit">岁</text>
        </view>
        <view class="field">
          <input class="input" type="digit" data-field="heightCm" value="{{form.heightCm}}" bindinput="onInput" placeholder="身高" />
          <text class="unit">cm</text>
        </view>
        <view class="field">
          <input class="input" type="digit" data-field="weightKg" value="{{form.weightKg}}" bindinput="onInput" placeholder="体重" />
          <text class="unit">kg</text>
        </view>
      </view>
      <view class="btn btn-primary btn-block next-btn" bindtap="next">下一步</view>
      <view class="btn-link back" bindtap="prev">上一步</view>
    </view>

    <view wx:elif="{{step === 2}}">
      <view class="mtitle">你的目标</view>
      <view class="msub">用于推荐合适的训练模板。</view>
      <view class="section">健身目标</view>
      <view class="pill-row">
        <view wx:for="{{goals}}" wx:key="*this" class="pill {{form.goal === item ? 'pill-sel' : ''}}" data-field="goal" data-value="{{item}}" bindtap="pick">{{item}}</view>
      </view>
      <view class="section">每周训练频率</view>
      <view class="pill-row">
        <view wx:for="{{freqs}}" wx:key="*this" class="pill {{form.frequency === item ? 'pill-sel' : ''}}" data-field="frequency" data-value="{{item}}" bindtap="pick">{{item}} 次</view>
      </view>
      <view class="btn btn-primary btn-block next-btn" bindtap="next">生成我的起点</view>
      <view class="btn-link back" bindtap="prev">上一步</view>
    </view>
  </view>
</view>
