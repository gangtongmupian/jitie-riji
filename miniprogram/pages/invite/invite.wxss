.loading {
  padding: 160rpx 0;
  text-align: center;
  color: var(--steel);
}
.invite-card {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.invite-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--charcoal);
}
.invite-sub {
  font-size: 26rpx;
  color: var(--steel);
  margin-top: 12rpx;
  text-align: center;
}
.invite-qr {
  margin: 36rpx 0 28rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: var(--r-md);
  border: 1rpx solid var(--hairline-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.qr-img {
  width: 100%;
  height: 100%;
}
.invite-qr-empty {
  font-size: 24rpx;
  color: var(--stone);
  text-align: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}
.invite-meta {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--charcoal);
}
.invite-state {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--stone);
}
.invite-state-ok {
  color: var(--success-deep);
  font-weight: 600;
}
.invite-hint {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--stone);
  text-align: center;
}
button.btn {
  margin: 0;
}
button.btn::after {
  border: none;
}
