.profile-card {
  padding: 32rpx;
}
.profile-head {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--tint-lavender);
  color: var(--primary-deep);
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
.profile-name {
  font-size: 34rpx;
  font-weight: 600;
}
.profile-sub {
  font-size: 26rpx;
  color: var(--slate);
  margin-top: 6rpx;
}
.edit-btn {
  margin-top: 28rpx;
}
.danger {
  color: var(--error);
}
.lrow-main {
  display: flex;
  flex-direction: column;
}
.lrow-sub {
  font-size: 22rpx;
  color: var(--stone);
  margin-top: 4rpx;
}
