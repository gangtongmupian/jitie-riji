<view class="page">
  <view class="pane">
    <view wx:if="{{profile && metrics}}" class="card profile-card">
      <view class="profile-head">
        <image wx:if="{{profile.avatarFileID}}" class="avatar" src="{{profile.avatarFileID}}" mode="aspectFill" />
        <view wx:else class="avatar">{{profile.gender === 'male' ? '男' : '女'}}</view>
        <view class="profile-info">
          <view class="profile-name">{{profile.gender === 'male' ? '男' : '女'}} · {{profile.age}} 岁</view>
          <view class="profile-sub">{{profile.heightCm}}cm · {{profile.weightKg}}kg · 目标 {{profile.goal}}</view>
        </view>
      </view>
      <view class="metric-grid">
        <view class="metric metric-tint-lavender">
          <text class="metric-b">{{metrics.bmi}}</text>
          <text class="metric-s">BMI · {{metrics.bmiLevelLabel}}</text>
        </view>
        <view class="metric metric-tint-mint">
          <text class="metric-b">{{metrics.bodyFatRef}}</text>
          <text class="metric-s">体脂参考</text>
        </view>
        <view class="metric metric-tint-sky">
          <text class="metric-b">{{metrics.bmr}}</text>
          <text class="metric-s">基础代谢 kcal</text>
        </view>
      </view>
      <view class="btn btn-ghost btn-block edit-btn" bindtap="edit">编辑资料</view>
    </view>

    <view class="section">成长与邀请</view>
    <view class="list">
      <view class="lrow" bindtap="invite">
        <view class="lrow-main">
          <text>邀请好友解锁进阶计划</text>
          <text class="lrow-sub">已邀请 {{inviteCount}} 人{{rewardUnlocked ? ' · 已解锁' : ''}}</text>
        </view>
        <text class="lrow-r">›</text>
      </view>
      <view wx:if="{{showRemind}}" class="lrow">
        <text>训练提醒</text>
        <switch checked="{{remindEnabled}}" bindchange="toggleRemind" color="#5645d4" />
      </view>
    </view>

    <view wx:if="{{showGroup || showContact}}" class="section">联系我们</view>
    <view wx:if="{{showGroup || showContact}}" class="list">
      <view wx:if="{{showGroup}}" class="lrow" bindtap="joinGroup"><text>加入训练交流群</text><text class="lrow-r">›</text></view>
      <view wx:if="{{showContact}}" class="lrow" bindtap="contact"><text>联系客服</text><text class="lrow-r">复制微信号</text></view>
    </view>

    <view class="section">设置</view>
    <view class="list">
      <view class="lrow" bindtap="edit"><text>编辑资料</text><text class="lrow-r">›</text></view>
      <view class="lrow" bindtap="privacy"><text>隐私政策</text><text class="lrow-r">›</text></view>
      <view class="lrow" bindtap="about"><text>关于牛来举铁</text><text class="lrow-r">›</text></view>
      <view class="lrow" bindtap="logout"><text class="danger">注销账号</text><text class="lrow-r">›</text></view>
    </view>
  </view>
</view>
