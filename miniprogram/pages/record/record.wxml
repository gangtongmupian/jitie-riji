<view class="page">
  <view class="pane record-pane">
    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'free' ? 'mode-on' : ''}}" data-mode="free" bindtap="switchMode">自由训练</view>
      <view class="mode-tab {{mode === 'template' ? 'mode-on' : ''}}" data-mode="template" bindtap="switchMode">模板训练</view>
    </view>

    <view wx:if="{{mode === 'template' && exercises.length}}" class="template-bar">
      <text class="template-name">当前模板：{{templateName}}</text>
      <text class="template-change" bindtap="openTemplates">换模板</text>
    </view>

    <view wx:if="{{loading}}" class="loading">加载动作库中…</view>

    <block wx:else>
      <view wx:if="{{exercises.length}}" class="weight-hint">重量口径：杠铃记总重量（杆＋两边挂片），哑铃记单只，器械记配重显示值</view>
      <view wx:if="{{!exercises.length}}" class="empty">
        <view class="empty-title">{{mode === 'template' ? '选择一个训练模板开始' : '添加动作开始训练'}}</view>
        <view class="btn btn-primary empty-btn" bindtap="{{mode === 'template' ? 'openTemplates' : 'openExercises'}}">
          {{mode === 'template' ? '选择模板' : '添加动作'}}
        </view>
      </view>

      <view wx:else>
        <view class="exercise-card card" wx:for="{{exercises}}" wx:for-item="ex" wx:for-index="ei" wx:key="exerciseId">
          <view class="ex-head">
            <view>
              <text class="ex-name">{{ex.name}}</text>
              <text class="tag">{{ex.equipment}}</text>
            </view>
            <text class="ex-del" data-ei="{{ei}}" bindtap="removeExercise">删除</text>
          </view>
          <view class="set-labels">
            <text class="set-label">重量 (kg)</text>
            <text class="set-label">次数</text>
            <text class="set-label set-label-op"></text>
          </view>
          <view class="set-row" wx:for="{{ex.sets}}" wx:for-item="s" wx:for-index="si" wx:key="_key">
            <input wx:if="{{ex.weighted}}" class="input set-input" type="digit" data-ei="{{ei}}" data-si="{{si}}" data-field="weight" value="{{s.weight}}" bindinput="onSetInput" placeholder="重量" />
            <view wx:else class="set-bw">自重</view>
            <input class="input set-input" type="number" data-ei="{{ei}}" data-si="{{si}}" data-field="reps" value="{{s.reps}}" bindinput="onSetInput" placeholder="次数" />
            <text class="set-op" data-ei="{{ei}}" data-si="{{si}}" bindtap="removeSet">−</text>
          </view>
          <view class="rest-row">
            <text class="rest-label">间歇</text>
            <view class="rest-stepper">
              <text class="rest-btn" data-ei="{{ei}}" bindtap="decRest">−</text>
              <text class="rest-val">{{ex.restMinutes}}分</text>
              <text class="rest-btn" data-ei="{{ei}}" bindtap="incRest">＋</text>
            </view>
            <view class="rest-stepper">
              <text class="rest-btn" data-ei="{{ei}}" bindtap="decRestSec">−</text>
              <text class="rest-val">{{ex.restSeconds}}秒</text>
              <text class="rest-btn" data-ei="{{ei}}" bindtap="incRestSec">＋</text>
            </view>
            <view class="rest-go {{ex.restRunning ? 'rest-going' : ''}}" data-ei="{{ei}}" bindtap="toggleRest">{{ex.restRunning ? ex.restText : '开始休息'}}</view>
          </view>
          <view class="add-set" data-ei="{{ei}}" bindtap="addSet">+ 加一组</view>
        </view>

        <view class="add-more" bindtap="openExercises">+ 添加动作</view>
      </view>
    </block>
  </view>

  <view class="sticky-bar">
    <view wx:if="{{activeRest && activeRest.done}}" class="rest-active rest-done">
      <view class="rest-active-info">
        <text class="rest-active-name">休息结束</text>
        <text class="rest-active-time rest-done-time">开始下一组！</text>
      </view>
      <view class="btn btn-primary rest-stop" bindtap="stopRestActive">知道了</view>
    </view>
    <view wx:elif="{{activeRest}}" class="rest-active">
      <view class="rest-active-info">
        <text class="rest-active-name">{{activeRest.name}}</text>
        <text class="rest-active-time">{{activeRest.text}}</text>
      </view>
      <view class="btn btn-ghost rest-stop" bindtap="stopRestActive">停止</view>
    </view>
    <block wx:else>
      <view class="totals">
        <text class="totals-b">{{totals.sets}} 组</text>
        <text class="totals-s">{{totals.exercises}} 个动作</text>
      </view>
      <view class="btn btn-primary finish-btn {{saving ? 'disabled' : ''}}" bindtap="finish">{{saving ? '保存中…' : '完成训练'}}</view>
    </block>
  </view>

  <view wx:if="{{showTemplatePicker || showExercisePicker}}" class="mask" bindtap="closePickers">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{showTemplatePicker ? '选择模板' : '添加动作'}}</text>
        <text class="sheet-close" bindtap="closePickers">关闭</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <view wx:if="{{showTemplatePicker}}">
          <view class="tpl card" wx:for="{{templates}}" wx:key="id" data-id="{{item.id}}" bindtap="pickTemplate">
            <view class="tpl-name">
              {{item.name}}
              <text class="tag {{item.genderHint === 'male' ? 'tag-blue' : (item.genderHint === 'female' ? 'tag-rose' : 'tag-gray')}}">{{item.genderText}}</text>
              <text wx:if="{{item.locked}}" class="tag tag-lock">🔒 邀请解锁</text>
            </view>
            <view class="tpl-meta">{{item.goal}} · 每周 {{item.frequency}} 次 · {{item.exercises.length}} 个动作</view>
          </view>
        </view>
        <view wx:else>
          <view class="custom-entry" bindtap="openCustomForm">＋ 自定义动作</view>
          <scroll-view scroll-x class="part-tabs">
            <view wx:for="{{bodyPartTabs}}" wx:key="*this" class="part-tab {{activeBodyPart === item ? 'part-tab-on' : ''}}" data-value="{{item}}" bindtap="selectBodyPart">{{item}}</view>
          </scroll-view>
          <block wx:for="{{filteredGroups}}" wx:for-item="g" wx:key="bodyPart">
            <view class="group-title">{{g.bodyPart}}</view>
            <view class="ex-item" wx:for="{{g.items}}" wx:for-item="e" wx:key="id" data-id="{{e.id}}" bindtap="pickExercise">
              <image wx:if="{{e.machine}}" class="ex-icon" src="{{e.machine.image}}" mode="aspectFit" />
              <image wx:else class="ex-icon" src="/images/glyphs/{{e.glyph}}.png" mode="aspectFit" />
              <view class="ex-item-info">
                <view class="ex-item-name">{{e.name}}</view>
                <view class="ex-item-en">{{e.enName}}{{e.machine ? ' · ' + e.machine.model : ''}}</view>
                <view class="ex-item-range">{{e.rangeText}}</view>
              </view>
              <view class="ex-item-ops">
                <view class="ex-demo" data-id="{{e.id}}" catchtap="openDetail">演示</view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showFinishSheet}}" class="mask" bindtap="closeFinishSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">完成训练</text>
        <text class="sheet-close" bindtap="closeFinishSheet">取消</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <view class="finish-summary">
          <view class="finish-metric">
            <text class="finish-metric-b">{{totals.sets}}</text>
            <text class="finish-metric-s">总组数</text>
          </view>
          <view class="finish-metric">
            <text class="finish-metric-b">{{totalsText.volume}}</text>
            <text class="finish-metric-s">总容量</text>
          </view>
          <view class="finish-metric">
            <text class="finish-metric-b">{{totals.exercises}}</text>
            <text class="finish-metric-s">动作数</text>
          </view>
        </view>
        <view class="section">本次消耗（kcal）</view>
        <input class="input finish-input" type="number" value="{{finishCalories}}" bindinput="onFinishCaloriesInput" placeholder="输入本次消耗" />
        <view class="finish-hint" wx:if="{{estimatedCalories > 0}}">自动预估约 {{estimatedCalories}} kcal，可修改，留空则使用预估</view>
        <view class="btn btn-primary btn-block finish-save" bindtap="confirmFinish">保存训练记录</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showDetail && detail}}" class="mask" bindtap="closeDetail">
    <view class="sheet detail-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">动作演示</text>
        <text class="sheet-close" bindtap="closeDetail">关闭</text>
      </view>
      <scroll-view scroll-y class="sheet-body detail-body">
        <view class="detail-name">{{detail.name}}</view>
        <view class="detail-en" wx:if="{{detail.enName}}">{{detail.enName}}</view>
        <view class="detail-tags">
          <text class="tag">{{detail.bodyPart}}</text>
          <text class="tag">{{detail.equipment}}</text>
          <text class="tag">{{detail.weights ? '负重' : '自重'}}</text>
        </view>
        <view wx:if="{{detail.machine}}" class="machine-photo">
          <image src="{{detail.machine.image}}" mode="aspectFit" class="machine-img" />
          <view class="machine-model">{{detail.machine.model}} · {{detail.machine.siteName}}</view>
        </view>
        <exercise-anim motion-key="{{detail.motion}}" glyph="{{detail.glyph}}" />
        <view class="section">目标肌群</view>
        <view class="pill-row" wx:if="{{detail.targets.length}}">
          <view class="pill" wx:for="{{detail.targets}}" wx:key="*this">{{item}}</view>
        </view>
        <view wx:else class="detail-none">暂无目标肌群数据</view>
        <view class="section">推荐重量</view>
        <view wx:if="{{detail.weights}}" class="weight-grid">
          <view class="weight-cell">
            <text class="weight-label">新手</text>
            <text class="weight-val">{{detail.weights.novice[0]}}–{{detail.weights.novice[1]}}kg</text>
          </view>
          <view class="weight-cell">
            <text class="weight-label">中级</text>
            <text class="weight-val">{{detail.weights.intermediate[0]}}–{{detail.weights.intermediate[1]}}kg</text>
          </view>
          <view class="weight-cell">
            <text class="weight-label">高级</text>
            <text class="weight-val">{{detail.weights.advanced[0]}}–{{detail.weights.advanced[1]}}kg</text>
          </view>
        </view>
        <view wx:else class="detail-none">自重动作，无需负重推荐</view>
        <view class="section">动作要领</view>
        <view wx:if="{{detail.steps.length}}">
          <view class="step-line" wx:for="{{detail.steps}}" wx:for-index="si" wx:key="*this">
            <text class="step-no">{{si + 1}}</text>
            <text class="step-text">{{item}}</text>
          </view>
        </view>
        <view wx:else class="detail-none">自定义动作暂无演示说明，请按自己熟悉的方式执行</view>
        <view class="section">注意事项</view>
        <view class="tip-line" wx:for="{{detail.tips}}" wx:key="*this">• {{item}}</view>
        <view class="btn btn-primary btn-block detail-add" data-id="{{detail.id}}" bindtap="pickExerciseFromDetail">使用此动作</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{showCustomForm}}" class="mask" bindtap="closeCustomForm">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">自定义动作</text>
        <text class="sheet-close" bindtap="closeCustomForm">关闭</text>
      </view>
      <scroll-view scroll-y class="sheet-body">
        <view class="section">动作名称</view>
        <input class="input" data-field="name" value="{{customForm.name}}" bindinput="onCustomInput" placeholder="如：早安体前屈" />
        <view class="section">训练部位</view>
        <view class="pill-row">
          <view wx:for="{{bodyParts}}" wx:key="*this" class="pill {{customForm.bodyPart === item ? 'pill-sel' : ''}}" data-value="{{item}}" bindtap="pickCustomBodyPart">{{item}}</view>
        </view>
        <view class="section">器械类型</view>
        <input class="input" data-field="equipment" value="{{customForm.equipment}}" bindinput="onCustomInput" placeholder="如：哑铃 / 器械 / 绳索" />
        <view class="section">类型</view>
        <view class="pill-row">
          <view class="pill {{customForm.weighted ? 'pill-sel' : ''}}" data-value="true" bindtap="toggleCustomWeighted">负重</view>
          <view class="pill {{!customForm.weighted ? 'pill-sel' : ''}}" data-value="false" bindtap="toggleCustomWeighted">自重</view>
        </view>
        <view class="btn btn-primary btn-block form-save" bindtap="saveCustomExercise">保存自定义动作</view>
      </scroll-view>
    </view>
  </view>
</view>
