.record-pane {
  padding-bottom: 200rpx;
}

.mode-tabs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 32rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--r-md);
  border: 1rpx solid var(--hairline-strong);
  color: var(--steel);
  font-size: 28rpx;
  font-weight: 500;
}
.mode-on {
  background: var(--ink);
  color: #fff;
  border-color: var(--ink);
}

.template-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
  background: var(--tint-lavender);
  border-radius: var(--r-md);
}
.template-name {
  font-size: 26rpx;
  color: var(--primary-deep);
  font-weight: 500;
}
.template-change {
  font-size: 26rpx;
  color: var(--link-blue);
  font-weight: 600;
}

.loading {
  padding: 120rpx 0;
  text-align: center;
  color: var(--steel);
}

.empty-btn {
  margin: 24rpx auto 0;
  width: 320rpx;
}

.exercise-card {
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
}
.ex-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.ex-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-right: 8rpx;
}
.ex-del {
  font-size: 26rpx;
  color: var(--error);
}
.set-labels {
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}
.set-label {
  flex: 1;
  font-size: 22rpx;
  color: var(--stone);
}
.set-label-op {
  width: 48rpx;
  flex: none;
}
.set-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 12rpx;
}
.set-input {
  flex: 1;
  height: 76rpx;
  font-size: 30rpx;
}
.set-bw {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: var(--surface);
  border-radius: var(--r-md);
  color: var(--steel);
  font-size: 26rpx;
}
.set-op {
  width: 48rpx;
  height: 48rpx;
  line-height: 44rpx;
  text-align: center;
  border: 1rpx solid var(--hairline-strong);
  border-radius: 50%;
  color: var(--steel);
  flex: none;
}
.add-set {
  font-size: 26rpx;
  color: var(--link-blue);
  padding: 4rpx 0;
}
.rest-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 16rpx 0 4rpx;
}
.rest-label {
  font-size: 24rpx;
  color: var(--steel);
}
.rest-stepper {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.rest-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border: 1rpx solid var(--hairline-strong);
  border-radius: 50%;
  color: var(--slate);
  font-size: 30rpx;
}
.rest-val {
  font-size: 26rpx;
  color: var(--ink);
  min-width: 72rpx;
  text-align: center;
}
.rest-go {
  margin-left: auto;
  padding: 10rpx 28rpx;
  border-radius: var(--r-md);
  background: var(--tint-mint);
  color: var(--success);
  font-size: 26rpx;
  font-weight: 600;
}
.rest-going {
  background: var(--tint-peach);
  color: var(--warning);
}
.add-more {
  text-align: center;
  padding: 20rpx;
  color: var(--link-blue);
  font-size: 28rpx;
}
.sticky-bar {
  z-index: 10;
}
.totals {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.totals-b {
  font-size: 30rpx;
  font-weight: 600;
}
.totals-s {
  font-size: 24rpx;
  color: var(--steel);
}
.rest-active {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.rest-active-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.rest-active-name {
  font-size: 24rpx;
  color: var(--steel);
}
.rest-active-time {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--warning);
}
.rest-stop {
  min-height: 72rpx;
  padding: 0 32rpx;
}
.finish-btn {
  width: 320rpx;
}
.disabled {
  opacity: 0.6;
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(15, 15, 15, 0.4);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: var(--surface-soft);
  border-radius: 32rpx 32rpx 0 0;
  max-height: 80vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 40rpx;
  border-bottom: 1rpx solid var(--hairline-soft);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}
.sheet-close {
  font-size: 28rpx;
  color: var(--steel);
}
.sheet-body {
  height: 60vh;
  padding: 8rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
}
.tpl {
  padding: 24rpx 28rpx;
  margin-bottom: 16rpx;
}
.tpl-name {
  font-size: 30rpx;
  font-weight: 600;
}
.tpl-meta {
  font-size: 24rpx;
  color: var(--slate);
  margin-top: 6rpx;
}
.group-title {
  font-size: 24rpx;
  color: var(--steel);
  font-weight: 600;
  margin: 20rpx 0 8rpx;
}
.ex-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--hairline-soft);
}
.ex-item-info {
  display: flex;
  flex-direction: column;
}
.ex-item-name {
  font-size: 30rpx;
  color: var(--charcoal);
}
.ex-item-en {
  font-size: 22rpx;
  color: var(--stone);
  margin-top: 2rpx;
}
.ex-item-range {
  font-size: 24rpx;
  color: var(--steel);
}
.custom-entry {
  margin: 20rpx 0 8rpx;
  padding: 24rpx;
  border: 1rpx dashed var(--primary);
  border-radius: var(--r-md);
  color: var(--primary);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
}
.part-tabs {
  white-space: nowrap;
  padding: 8rpx 0 16rpx;
}
.part-tab {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  border-radius: var(--r-full);
  background: var(--canvas);
  border: 1rpx solid var(--hairline);
  color: var(--steel);
  font-size: 26rpx;
  font-weight: 500;
}
.part-tab-on {
  background: var(--ink);
  color: #fff;
  border-color: var(--ink);
}
.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.form-save {
  margin-top: 40rpx;
}
