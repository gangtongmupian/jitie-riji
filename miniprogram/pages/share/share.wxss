.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 750px;
  height: 1000px;
}

.preview-card {
  position: relative;
  overflow: hidden;
  border-radius: var(--r-lg);
  border: 1rpx solid var(--hairline);
  background: #fff;
  min-height: 720rpx;
}
.pv-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.pv-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.5);
}
.pv-content {
  position: relative;
  padding: 48rpx;
  color: var(--ink);
}
.pv-dark {
  color: #fff;
}
.pv-brand {
  font-size: 34rpx;
  font-weight: 600;
}
.pv-tag {
  display: inline-flex;
  margin-top: 16rpx;
  background: var(--primary);
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: var(--r-sm);
}
.pv-label {
  margin-top: 96rpx;
  font-size: 24rpx;
  color: var(--steel);
}
.pv-dark .pv-label {
  color: rgba(255, 255, 255, 0.72);
}
.pv-volume {
  font-size: 84rpx;
  font-weight: 600;
  letter-spacing: -2rpx;
}
.pv-volume-sm {
  font-size: 52rpx;
}
.pv-divider {
  height: 2rpx;
  background: var(--hairline);
  margin: 28rpx 0;
}
.pv-divider-dark {
  background: rgba(255, 255, 255, 0.35);
}
.pv-ex {
  margin-bottom: 20rpx;
}
.pv-ex-name {
  font-size: 28rpx;
  font-weight: 500;
}
.pv-ex-meta {
  font-size: 22rpx;
  color: var(--steel);
  margin-top: 4rpx;
}
.pv-dark .pv-ex-meta {
  color: rgba(255, 255, 255, 0.72);
}
.pv-date {
  margin-top: 64rpx;
  font-size: 24rpx;
  color: var(--steel);
}
.pv-dark .pv-date {
  color: rgba(255, 255, 255, 0.72);
}

.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.action-btn {
  flex: 1;
}
.done {
  display: block;
  text-align: center;
  margin-top: 32rpx;
}
.empty-btn {
  width: 320rpx;
  margin: 24rpx auto 0;
}
